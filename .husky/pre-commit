#!/usr/bin/env sh
set -e

staged_py_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ -z "$staged_py_files" ]; then
  exit 0
fi

# Auto-fix fixable ruff issues on staged Python files before commit.
printf '%s\n' "$staged_py_files" | xargs uv run ruff check --fix
printf '%s\n' "$staged_py_files" | xargs git add
