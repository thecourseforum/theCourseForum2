# =============================================================================
# REQUIRED FOR ALL ENVIRONMENTS
# =============================================================================
SECRET_KEY=any-random-string

# =============================================================================
# LOCAL DEVELOPMENT AND CI (docker compose)
# =============================================================================
DB_NAME=tcf_db
DB_USER=tcf_django
DB_PASSWORD=s3kr1t
DB_HOST=tcf_db
DB_PORT=5432

# Shared cache; same engine (Valkey) as prod's ElastiCache.
REDIS_URL=redis://tcf_valkey:6379/0

# S3-compatible media storage (MinIO container); mirrors prod's S3 backend.
MINIO_ENDPOINT=http://tcf-minio:9000
MINIO_BUCKET=tcf-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Static files are collected to MinIO and served through the Caddy CDN.
STATIC_BUCKET=tcf-static
STATIC_CUSTOM_DOMAIN=localhost:8081

# =============================================================================
# OPTIONAL - For auth features (login/logout/profile)
# =============================================================================
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# COGNITO_APP_CLIENT_SECRET=
# COGNITO_DOMAIN=
# COGNITO_REGION_NAME=us-east-1

# =============================================================================
# OPTIONAL - For prod_dump.sh script (must activate EC2 instances & get pem key)
# =============================================================================
# EC2_HOST=
# EC2_USER=
# PEM_KEY=path/to/your/key.pem
# PROD_DB_HOST=
# PROD_DB_USER=
# PROD_DB_PASSWORD=

# =============================================================================
# OPTIONAL - For generate_ai_summaries management command
# =============================================================================
# OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL - For aws configure
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# OPTIONAL - For load_review_drive management command
# =============================================================================
# REVIEW_DRIVE_ID=
# REVIEW_DRIVE_EMAIL=
# REVIEW_DRIVE_PASSWORD=